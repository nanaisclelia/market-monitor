<script>
(function () {
  var root = document.documentElement, mq = window.matchMedia("(prefers-color-scheme: dark)");
  function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }
  var modeBtns = document.querySelectorAll("[data-mode]"), langBtns = document.querySelectorAll("[data-lang]");
  function effective() { return root.getAttribute("data-theme") || (mq.matches ? "dark" : "light"); }
  function sync() {
    var e = effective(), l = root.getAttribute("data-lang") || "zh";
    modeBtns.forEach(function (b) { b.setAttribute("aria-pressed", String(b.dataset.mode === e)); });
    langBtns.forEach(function (b) { b.setAttribute("aria-pressed", String(b.dataset.lang === l)); });
  }
  function setLang(l) { root.setAttribute("data-lang", l); root.setAttribute("lang", l === "en" ? "en" : "zh-CN"); }
  var savedMode = store("mm-theme"); if (savedMode === "light" || savedMode === "dark") root.setAttribute("data-theme", savedMode);
  var savedLang = store("mm-lang"); setLang(savedLang === "en" ? "en" : "zh");
  modeBtns.forEach(function (b) { b.addEventListener("click", function () { root.setAttribute("data-theme", b.dataset.mode); store("mm-theme", b.dataset.mode); sync(); }); });
  langBtns.forEach(function (b) { b.addEventListener("click", function () { setLang(b.dataset.lang); store("mm-lang", b.dataset.lang); sync(); }); });
  if (mq.addEventListener) mq.addEventListener("change", sync);
  new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["data-theme", "data-lang"] });
  sync();

  // 表格排序（数值列，点击切换降序 / 升序）
  document.querySelectorAll("table.sortable th[data-sort]").forEach(function (th) {
    th.tabIndex = 0;
    function go() {
      var table = th.closest("table"), tbody = table.tBodies[0], idx = Array.prototype.indexOf.call(th.parentNode.children, th);
      var dir = th.getAttribute("aria-sort") === "descending" ? "ascending" : "descending";
      table.querySelectorAll("th[data-sort]").forEach(function (h) { h.removeAttribute("aria-sort"); });
      th.setAttribute("aria-sort", dir);
      var rows = Array.prototype.slice.call(tbody.rows);
      function val(r) { var c = r.cells[idx]; var v = c && c.dataset.v; var n = parseFloat(v); return isNaN(n) ? -Infinity : n; }
      rows.sort(function (a, b) { return dir === "descending" ? val(b) - val(a) : val(a) - val(b); });
      rows.forEach(function (r) { tbody.appendChild(r); });
    }
    th.addEventListener("click", go);
    th.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); go(); } });
  });

  // 筛选：同一块内的表格行和详情卡片一起过滤
  document.querySelectorAll(".tbl").forEach(function (box) {
    var section = box.closest("section"), mode = "all", hide = {};
    function items() { return section.querySelectorAll("tbody tr[data-" + (box.dataset.table === "cpo" ? "market" : "filing") + "], details.card[data-filing]"); }
    var table = box.querySelector("table.sortable"), empty = box.querySelector(".empty");
    function label(btn) {
      var zh = btn.querySelector(".l-zh"), en = btn.querySelector(".l-en");
      return { zh: zh ? zh.textContent : btn.textContent, en: en ? en.textContent : btn.textContent };
    }
    function apply() {
      items().forEach(function (el) {
        var d = el.dataset, show = true;
        if (mode === "us" || mode === "cn") show = d.market === mode;
        else if (mode !== "all") show = d[mode] === "1";
        Object.keys(hide).forEach(function (k) { if (hide[k] && d[k] === "1") show = false; });
        el.hidden = !show;
      });
      if (!table || !empty) return;
      var rows = Array.prototype.slice.call(table.tBodies[0].rows), vis = rows.filter(function (r) { return !r.hidden; }).length;
      if (vis > 0) { empty.hidden = true; table.parentNode.hidden = false; return; }
      var active = [], pressed = box.querySelector('[data-filter][aria-pressed="true"]');
      if (pressed && pressed.dataset.filter !== "all") active.push(label(pressed));
      box.querySelectorAll('[data-hide][aria-pressed="true"]').forEach(function (b) { active.push(label(b)); });
      var what = box.dataset.table === "cpo" ? { zh: "标的", en: "names" } : { zh: "异动标的", en: "movers" };
      var cz = active.map(function (a) { return "「" + a.zh + "」"; }).join(" + "), ce = active.map(function (a) { return "\u201c" + a.en + "\u201d"; }).join(" + ");
      empty.innerHTML = '<span class="l-zh"><b>暂无符合条件的' + what.zh + '</b> · 今日 ' + rows.length + ' 只' + what.zh + '中，0 只符合' + cz + '。</span>' +
        '<span class="l-en" lang="en"><b>No matching ' + what.en + '</b> · 0 of today\'s ' + rows.length + ' ' + what.en + ' match ' + ce + '.</span>' +
        '<button type="button" data-reset><span class="l-zh">查看全部</span><span class="l-en" lang="en">Show all</span></button>';
      empty.hidden = false; table.parentNode.hidden = true;
      empty.querySelector("[data-reset]").addEventListener("click", function () {
        mode = "all"; hide = {};
        box.querySelectorAll("[data-filter]").forEach(function (x) { x.setAttribute("aria-pressed", String(x.dataset.filter === "all")); });
        box.querySelectorAll("[data-hide]").forEach(function (x) { x.setAttribute("aria-pressed", "false"); });
        apply();
      });
    }
    box.querySelectorAll("[data-cols]").forEach(function (b) {
      b.addEventListener("click", function () {
        var on = b.getAttribute("aria-pressed") !== "true";
        b.setAttribute("aria-pressed", String(on));
        if (table) table.classList.toggle("compact", !on);
      });
    });
    box.querySelectorAll("[data-filter]").forEach(function (b) {
      b.addEventListener("click", function () {
        mode = b.dataset.filter;
        box.querySelectorAll("[data-filter]").forEach(function (x) { x.setAttribute("aria-pressed", String(x === b)); });
        apply();
      });
    });
    box.querySelectorAll("[data-hide]").forEach(function (b) {
      b.addEventListener("click", function () {
        var k = b.dataset.hide; hide[k] = !hide[k]; b.setAttribute("aria-pressed", String(hide[k])); apply();
      });
    });
  });

  // 点击表格中的代码时展开对应卡片
  document.querySelectorAll('a[href^="#a-"]').forEach(function (a) {
    a.addEventListener("click", function () { var d = document.getElementById(a.getAttribute("href").slice(1)); if (d && d.tagName === "DETAILS") d.open = true; });
  });

  // 导航高亮 + 回到顶部
  var links = Array.prototype.slice.call(document.querySelectorAll(".subnav a[href^='#']"));
  var totop = document.getElementById("totop");
  if ("IntersectionObserver" in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        links.forEach(function (l) { l.classList.toggle("on", l.getAttribute("href") === "#" + e.target.id); });
      });
    }, { rootMargin: "-120px 0px -60% 0px" });
    links.forEach(function (l) { var t = document.querySelector(l.getAttribute("href")); if (t) io.observe(t); });
  }
  window.addEventListener("scroll", function () { if (totop) totop.hidden = window.scrollY < 600; }, { passive: true });
})();
</script>
{% if not public %}</body>
</html>{% endif %}
